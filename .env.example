# Salin menjadi .env lalu isi. JANGAN commit file .env.

# --- Mode ---
# False saat di-hosting
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=ganti-dengan-50-karakter-acak
# di hosting: domain anda, mis. ops.seanavgroup.co.id
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# di hosting: https://ops.seanavgroup.co.id
DJANGO_CSRF_TRUSTED_ORIGINS=
# izinkan akses lewat IP LAN saat mode lokal
DJANGO_ALLOW_LAN=True

# --- Database (pilih salah satu) ---
# A) Hosting: satu URL
# DATABASE_URL=postgres://user:password@host:5432/seanav
# B) Lokal
DB_NAME=seanav_dev
DB_USER=postgres
DB_PASSWORD=isi-password-postgresql
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Akun admin pertama (dibuat otomatis oleh init_database bila belum ada) ---
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_EMAIL=

# --- Absensi ---
ABSENSI_JAM_MASUK=08:00
ABSENSI_TOLERANSI_MENIT=15
ABSENSI_WAJIB_FOTO=False
# titik kantor (IDX Tower II); kosongkan untuk menonaktifkan
KANTOR_LAT=-6.2237
KANTOR_LNG=106.8085
KANTOR_RADIUS_M=200

# --- Penyimpanan foto di cloud (wajib di Vercel): Supabase Storage / Cloudflare R2 / AWS S3 ---
# S3_BUCKET=seanav
# S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-southeast-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- PDF quotation/invoice: auto | word | libreoffice ---
PDF_CONVERTER=auto

# --- Khusus docker-compose (VPS) ---
# DOMAIN=ops.seanavgroup.co.id
